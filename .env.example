# =====================================================================
# SaaS 智能客服系统 · 配置模板
# 复制为 .env 后填写。.env 不提交、不入交付物。
# 全部配置项均有默认值，除 LLM_API_KEY 外可零改动启动本机演示。
# =====================================================================

# ---------------- 运行环境 ----------------
ENV=local
DEBUG=true
TIMEZONE=Asia/Shanghai

# ---------------- 服务端口 ----------------
API_HOST=127.0.0.1
API_PORT=8011
MOCK_HOST=127.0.0.1
MOCK_PORT=8010
STREAMLIT_PORT=8502

# ---------------- 大模型（必填）----------------
# 端点与模型名需以实测为准，不采信二手信息
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ---------------- 向量检索 ----------------
# provider=local 使用项目内确定性本地向量化（零密钥、零下载）
# provider=st    使用本机句向量模型（需 EMBEDDING_MODEL_PATH 指向本机模型目录）
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=512
EMBEDDING_MODEL_PATH=
CHROMA_COLLECTION=support_knowledge
RAG_TOP_K=4
RAG_MIN_SCORE=0.15

# ---------------- PostgreSQL（主从）----------------
PG_HOST=127.0.0.1
PG_PRIMARY_PORT=5432
PG_REPLICA_PORT=5433
PG_USER=saaskefu
PG_PASSWORD=saaskefu_local
PG_DATABASE=saaskefu
PG_POOL_SIZE=10
PG_MAX_OVERFLOW=20
PG_REPLICA_ENABLED=true
PG_STATEMENT_TIMEOUT_MS=15000

# ---------------- Redis ----------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=3

# ---------------- 鉴权 ----------------
# 生产环境必须替换为随机长密钥
JWT_USER_SECRET=replace-with-random-32byte-secret-for-user-audience
JWT_AGENT_SECRET=replace-with-random-32byte-secret-for-agent-audience
JWT_ALGORITHM=HS256
JWT_USER_TTL_MINUTES=720
JWT_AGENT_TTL_MINUTES=480

# ---------------- 限流 ----------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_WINDOW_SECONDS=60

# ---------------- 会话与坐席 ----------------
SESSION_TTL_SECONDS=1800
AGENT_HEARTBEAT_INTERVAL_SECONDS=10
AGENT_HEARTBEAT_TTL_SECONDS=30
AGENT_LOCK_TTL_SECONDS=120
# 掉线坐席巡检周期（秒）；0 = 关闭自动巡检。
# 被动掉线（进程崩溃/断网）不会触发任何请求，必须靠定时巡检回收其名下会话。
AGENT_OFFLINE_SWEEP_SECONDS=30
ESCALATION_QUEUE_KEY=cs:queue:escalation

# ---------------- 转人工阈值 ----------------
ESCALATE_MAX_STEPS=3
ESCALATE_EMOTION_INTENSITY=7
ESCALATE_AMOUNT_THRESHOLD=100
ESCALATE_COMPLAINT_THRESHOLD=2

# ---------------- 计费安全 ----------------
BILLING_HMAC_SECRET=replace-with-random-32byte-hmac-secret
BILLING_TIMESTAMP_WINDOW_SECONDS=300
BILLING_NONCE_TTL_SECONDS=600

# ---------------- 容错 ----------------
MOCK_TIMEOUT_SECONDS=5
MOCK_MAX_RETRIES=2
MOCK_BASE_URL=

# ---------------- 观测 ----------------
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_JSON=true
SLOW_STEP_THRESHOLD_MS=3000
